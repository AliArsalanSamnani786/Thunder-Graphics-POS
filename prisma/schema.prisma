generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED_TRIAL_EXPIRED
  SUSPENDED
  MANUAL_REVIEW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum SaleStatus {
  DRAFT
  HELD
  COMPLETED
  RETURNED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
}

enum StockMovementType {
  SALE
  RETURN
  PURCHASE
  TRANSFER
  ADJUSTMENT
  STOCK_IN
  STOCK_OUT
}

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @unique
  name         String
  status       TenantStatus @default(TRIAL)
  country      String
  trialStartAt DateTime?
  trialEndAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  branches     Branch[]
  warehouses   Warehouse[]
  products     Product[]
  customers    Customer[]
  suppliers    Supplier[]
  sales        Sale[]
  accounts     Account[]
  auditLogs    AuditLog[]
  riskEvents   RiskEvent[]
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String?    @db.Uuid
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(PENDING_VERIFICATION)
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  roles        UserRole[]
  auditLogs    AuditLog[]

  @@index([tenantId, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @db.Uuid
  name        String
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  country   String?
  createdAt DateTime @default(now())

  warehouses Warehouse[]
  sales      Sale[]

  @@index([tenantId, name])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  createdAt DateTime @default(now())

  stockItems StockItem[]

  @@index([tenantId, name])
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @db.Uuid
  name     String
  products Product[]

  @@unique([tenantId, name])
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @db.Uuid
  name     String
  products Product[]

  @@unique([tenantId, name])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String?          @db.Uuid
  category    Category?        @relation(fields: [categoryId], references: [id])
  brandId     String?          @db.Uuid
  brand       Brand?           @relation(fields: [brandId], references: [id])
  name        String
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]

  @@index([tenantId, name])
}

model ProductVariant {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  productId   String      @db.Uuid
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String
  barcode     String?
  unitPrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 4)
  stockItems  StockItem[]
  saleItems   SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
}

model StockItem {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  warehouseId   String           @db.Uuid
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  variantId     String           @db.Uuid
  variant       ProductVariant   @relation(fields: [variantId], references: [id])
  quantity      Decimal          @default(0) @db.Decimal(12, 3)
  reserved      Decimal          @default(0) @db.Decimal(12, 3)
  batchNumber   String?
  serialNumber  String?
  expiresAt     DateTime?
  movements     StockMovement[]

  @@index([tenantId, warehouseId, variantId])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  stockItemId String            @db.Uuid
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  reference   String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, createdAt])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  sales Sale[]

  @@index([tenantId, phone])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  @@index([tenantId, name])
}

model Sale {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?     @db.Uuid
  branch      Branch?     @relation(fields: [branchId], references: [id])
  customerId  String?     @db.Uuid
  customer    Customer?   @relation(fields: [customerId], references: [id])
  receiptNo   String
  status      SaleStatus  @default(DRAFT)
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  items       SaleItem[]
  payments    SalePayment[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  saleId    String         @db.Uuid
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @db.Decimal(12, 2)
  tax       Decimal        @default(0) @db.Decimal(12, 2)
  discount  Decimal        @default(0) @db.Decimal(12, 2)
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  saleId    String        @db.Uuid
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())
}

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      String
  createdAt DateTime @default(now())

  lines JournalLine[]

  @@unique([tenantId, code])
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  reference   String?
  description String?
  postedAt    DateTime      @default(now())
  lines       JournalLine[]

  @@index([tenantId, postedAt])
}

model JournalLine {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
}

model RiskEvent {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level     RiskLevel
  reason    String
  ipAddress String?
  deviceId  String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
