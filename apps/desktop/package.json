{
  "name": "@thunder-pos/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "author": "Thunder POS",
  "description": "Secure multi-tenant POS, inventory, and accounting software.",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.thunderpos.app",
    "productName": "Thunder POS",
    "copyright": "Copyright © 2026 Thunder POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Thunder POS",
      "artifactName": "Thunder-POS-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "web/out/**/*"
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  }
}
